# Copy to .env.local for local development. Never commit real values.
# Local values come from `pnpm exec supabase status` after `supabase start`.

# --- Supabase (public; safe in the browser) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (server only; used ONLY from src/server/privileged/*) ---
SUPABASE_SECRET_KEY=

# --- Upstash Redis (rate limiting only; never on the answer path) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Observability (Day 1 follow-up: Sentry with PII scrubbing) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- LLM providers (Day 7; generator and verifier from different families) ---
# GENERATOR_API_KEY=
# VERIFIER_API_KEY=
# LLM_DAILY_COST_CEILING_USD=

# --- Stripe (Phase 3) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
